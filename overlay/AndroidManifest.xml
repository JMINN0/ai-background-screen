<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.overlay"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务（Android 14+ 必须声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="AI 画面"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- 故意不加 LAUNCHER intent-filter，这样它不会出现在桌面和应用列表里。
             启动方式只有 adb shell am start（参数用 ei port 传端口），
             插件会自动这样做，用户不需要手动启动。 -->
        <!-- **必须 singleTask**：重复 am start 不能堆出多个 Activity/进程。
             实机踩到过两个 overlay 进程同时存在、旧窗口残留 4 个的情况。 -->
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 探针：以 App 身份打印 DisplayManager 视角，用来验证虚拟屏对别的 App 可不可见。
             只在排查时用，不参与正常运行。 -->
        <activity android:name=".ProbeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Surface 直通实验（2026-11-24）。
             验证「普通 App 能不能把 shell 拥有的虚拟屏镜像到自己的 SurfaceView」。
             如果成立，framesrv + ImageReader + JPEG + HTTP 整条管线可以删掉。
             用可见主题（要显示 SurfaceView），只在实验时启动，不参与正常运行。 -->
        <activity android:name=".SurfaceProbeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <service android:name=".OverlayService"
            android:exported="false" />
    </application>
</manifest>
