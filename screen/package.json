{
  "name": "offscreen-android",
  "version": "0.1.1",
  "description": "Give an AI agent its own invisible Android screen. VirtualDisplay + scrcpy over adb, no root. MCP server and CLI included.",
  "keywords": [
    "android",
    "virtual-display",
    "ai-agent",
    "mcp",
    "scrcpy",
    "adb",
    "computer-use",
    "no-root",
    "automation",
    "headless"
  ],
  "license": "MIT",
  "author": "JMINNO",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "bin/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "bin": {
    "offscreen-android": "./bin/vdisplay.mjs",
    "offscreen-androidd": "./bin/vdisplayd.mjs",
    "offscreen-android-mcp": "./bin/mcp-server.mjs"
  },
  "homepage": "https://github.com/JMINN0/offscreen-android#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JMINN0/offscreen-android.git"
  }
}
