{
  "name": "ai-background-screen",
  "version": "0.4.0",
  "description": "Android virtual display for AI agents: run any app on a hidden second screen while you keep using your phone. No root, ADB only. MCP server + CLI.",
  "keywords": [
    "android",
    "virtual-display",
    "android-virtual-display",
    "virtual-display-android",
    "ai-agent",
    "ai-agents",
    "phone-agent",
    "mobile-agent",
    "computer-use",
    "gui-agent",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "scrcpy",
    "adb",
    "adb-shell",
    "no-root",
    "android-automation",
    "phone-automation",
    "headless"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "JMINNO",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "bin/",
    "assets/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "bin": {
    "ai-background-screen": "./bin/vdisplay.mjs",
    "ai-background-screen-daemon": "./bin/vdisplayd.mjs",
    "ai-background-screen-mcp": "./bin/mcp-server.mjs",
    "offscreen-android": "./bin/vdisplay.mjs",
    "offscreen-android-daemon": "./bin/vdisplayd.mjs",
    "offscreen-android-mcp": "./bin/mcp-server.mjs",
    "vdisplay": "./bin/vdisplay.mjs",
    "vdisplay-daemon": "./bin/vdisplayd.mjs",
    "vdisplay-mcp": "./bin/mcp-server.mjs",
    "vdisplay-start": "./bin/vdisplay.mjs"
  },
  "homepage": "https://github.com/JMINN0/ai-background-screen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JMINN0/ai-background-screen.git"
  }
}